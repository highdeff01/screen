{
  "name": "sightline-screen-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI screen-control and UI test console with workflows, background runs, evidence review and a tool registry.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "sightline": "node bin/sightline.mjs",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=2 test/"
  },
  "bin": {
    "sightline": "bin/sightline.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
